// ============================================================
// ChunkSection
// ============================================================

ChunkSection::ChunkSection() {
    blocks_.fill(0); // air = state ID 0
    biomes_.fill(0); // plains = biome ID 0
    nonAirCount_ = 0;
}

void ChunkSection::setBlock(i32 x, i32 y, i32 z, i32 stateId) {
    auto idx = blockIndex(x, y, z);
    i32 old = blocks_[idx];
    if (old == stateId) return;

    // Подсчёт non-air
    auto& mgr = registries::RegistryManager::instance();
    const auto* oldState = mgr.blockStates().getById(old);
    const auto* newState = mgr.blockStates().getById(stateId);

    bool wasAir = !oldState || oldState->isAir();
    bool isAir = newState && newState->isAir();

    if (wasAir && !isAir) nonAirCount_++;
    else if (!wasAir && isAir) nonAirCount_--;

    blocks_[idx] = stateId;
}

i32 ChunkSection::getBlock(i32 x, i32 y, i32 z) const {
    return blocks_[blockIndex(x, y, z)];
}

void ChunkSection::setBiome(i32 x, i32 y, i32 z, i32 biomeId) {
    biomes_[biomeIndex(x, y, z)] = biomeId;
}

i32 ChunkSection::getBiome(i32 x, i32 y, i32 z) const {
    return biomes_[biomeIndex(x, y, z)];
}

void ChunkSection::writeTo(net::Buffer& buf) const {
    // Блоки: block count (i16) + bits per block (u8) + palette + data
    // Упрощённый формат для старта:
    // bits per block = 15 (irect palette, не sparse)

    buf.writeI16(static_cast<i16>(nonAirCount_));

    // Bits per block
    u8 bitsPerBlock = 15; //irect palette для 1.21.1
    buf.writeByte(bitsPerBlock);

    // Palette (irect): просто записываем количество элементов
    // В irect palette нет palette массива — данные напрямую state ID

    // Data array: long array
    // Каждый блок = 15 бит, 8 блоков в long
    size_t longsNeeded = (BLOCKS_PER_SECTION * bitsPerBlock + 63) / 64;
    buf.writeVarInt(static_cast<i32>(longsNeeded));

    // Пакуем блоки в longs
    std::vector<u64> longs(longsNeeded, 0);
    for (size_t i = 0; i < BLOCKS_PER_SECTION; ++i) {
        size_t bitIndex = i * bitsPerBlock;
        size_t longIndex = bitIndex / 64;
        size_t bitOffset = bitIndex % 64;

        u64 val = static_cast<u64>(blocks_[i] & ((1 << bitsPerBlock) - 1));
        longs[longIndex] |= val << bitOffset;

        // Если блок пересекает границу long
        if (bitOffset + bitsPerBlock > 64 && longIndex + 1 < longsNeeded) {
            longs[longIndex + 1] |= val >> (64 - bitOffset);
        }
    }

    for (auto l : longs) {
        buf.writeU64(l);
    }

    // Biomes: bits per biome = 4 (indirect palette)
    u8 bitsPerBiome = 4;
    buf.writeByte(bitsPerBiome);

    // Palette: build from actual biomes in this section
    std::vector<i32> palette;
    for (size_t i = 0; i < BIOMES_PER_SECTION; ++i) {
        i32 bid = biomes_[i];
        bool found = false;
        for (auto& p : palette) {
            if (p == bid) { found = true; break; }
        }
        if (!found) palette.push_back(bid);
    }

    // Palette entries
    buf.writeVarInt(static_cast<i32>(palette.size()));
    for (auto p : palette) {
        buf.writeVarInt(p);
    }

    // Biome data: 64 биома, 4 бита каждый = 8 long
    size_t biomeLongsNeeded = (BIOMES_PER_SECTION * bitsPerBiome + 63) / 64;
    buf.writeVarInt(static_cast<i32>(biomeLongsNeeded));

    std::vector<u64> biomeLongs(biomeLongsNeeded, 0);
    for (size_t i = 0; i < BIOMES_PER_SECTION; ++i) {
        size_t bitIndex = i * bitsPerBiome;
        size_t longIndex = bitIndex / 64;
        size_t bitOffset = bitIndex % 64;

        // Find palette index
        i32 bid = biomes_[i];
        i32 pidx = 0;
        for (size_t j = 0; j < palette.size(); ++j) {
            if (palette[j] == bid) { pidx = static_cast<i32>(j); break; }
        }

        u64 val = static_cast<u64>(pidx & ((1 << bitsPerBiome) - 1));
        biomeLongs[longIndex] |= val << bitOffset;
        if (bitOffset + bitsPerBiome > 64 && longIndex + 1 < biomeLongsNeeded) {
            biomeLongs[longIndex + 1] |= val >> (64 - bitOffset);
        }
    }

    for (auto l : biomeLongs) {
        buf.writeU64(l);
    }
}

// ============================================================
// ChunkColumn
// ============================================================

ChunkColumn::ChunkColumn(i32 x, i32 z) : x_(x), z_(z) {
    for (auto& sec : sections_) {
        sec = std::make_unique<ChunkSection>();
    }
}

ChunkSection& ChunkColumn::getSection(i32 index) {
    return *sections_.at(static_cast<size_t>(index));
}

const ChunkSection& ChunkColumn::getSection(i32 index) const {
    return *sections_.at(static_cast<size_t>(index));
}

void ChunkColumn::setBlock(i32 x, i32 y, i32 z, i32 stateId) {
    i32 secIdx = sectionIndex(y);
    if (secIdx < 0 || secIdx >= SECTIONS_PER_CHUNK) return;
    sections_[static_cast<size_t>(secIdx)]->setBlock(x, y, z, stateId);
    dirty_ = true;
}

i32 ChunkColumn::getBlock(i32 x, i32 y, i32 z) const {
    i32 secIdx = sectionIndex(y);
    if (secIdx < 0 || secIdx >= SECTIONS_PER_CHUNK) return 0;
    return sections_[static_cast<size_t>(secIdx)]->getBlock(x, y, z);
}

void ChunkColumn::writeTo(net::Buffer& buf, bool includeBiomes) const {
    // 1.21.1 Chunk Data payload:
    // i32: heightmap type (0 = World surface)
    // varint: primary bit mask (какие секции отправляем)
    // chunk data: секции

    // Heightmaps (пропускаем — необязательно для базовой работы)
    // Пока просто отправляем пустой NBT для heightmaps

    // Chunk sections
    for (i32 i = 0; i < SECTIONS_PER_CHUNK; ++i) {
        sections_[static_cast<size_t>(i)]->writeTo(buf);
    }
}

// ============================================================
// World
// ============================================================

std::shared_ptr<ChunkColumn> World::getChunk(i32 x, i32 z) {
    ChunkPos pos{x, z};
    auto it = chunks_.find(pos);
    return it != chunks_.end() ? it->second : nullptr;
}

std::shared_ptr<ChunkColumn> World::getChunkOrCreate(i32 x, i32 z) {
    ChunkPos pos{x, z};
    auto it = chunks_.find(pos);
    if (it != chunks_.end()) return it->second;

    auto chunk = std::make_shared<ChunkColumn>(x, z);
    chunks_[pos] = chunk;
    return chunk;
}

void World::setBlock(i32 x, i32 y, i32 z, i32 stateId) {
    i32 cx = x >> 4;
    i32 cz = z >> 4;
    auto chunk = getChunkOrCreate(cx, cz);
    chunk->setBlock(x, y, z, stateId);
}

i32 World::getBlock(i32 x, i32 y, i32 z) const {
    i32 cx = x >> 4;
    i32 cz = z >> 4;
    ChunkPos pos{cx, cz};
    auto it = chunks_.find(pos);
    if (it == chunks_.end()) return 0;
    return it->second->getBlock(x, y, z);
}

void World::unloadChunk(i32 x, i32 z) {
    chunks_.erase(ChunkPos{x, z});
}

void World::generateFlat(i64 seed, i32 centerX, i32 centerZ, i32 radius) {
    auto& mgr = registries::RegistryManager::instance();

    // Flat мир: bedrock(-64) + dirt(-63..-61) + grass_block(-62)
    // Но для simplicity: bedrock(-64) + dirt(3 слоя) + grass(1 слой)
    i32 bedrockId = mgr.getBlockStateId("minecraft:bedrock").value_or(33);
    i32 dirtId = mgr.getBlockStateId("minecraft:dirt").value_or(10);
    i32 grassId = mgr.getBlockStateId("minecraft:grass_block", {{"snowy", "false"}}).value_or(8);

    for (i32 cx = centerX - radius; cx <= centerX + radius; ++cx) {
        for (i32 cz = centerZ - radius; cz <= centerZ + radius; ++cz) {
            auto chunk = getChunkOrCreate(cx, cz);

            for (i32 lx = 0; lx < 16; ++lx) {
                for (i32 lz = 0; lz < 16; ++lz) {
                    i32 worldX = cx * 16 + lx;
                    i32 worldZ = cz * 16 + lz;

                    // bedrock на дне
                    chunk->setBlock(worldX, -64, worldZ, bedrockId);
                    // 3 слоя dirt
                    chunk->setBlock(worldX, -63, worldZ, dirtId);
                    chunk->setBlock(worldX, -62, worldZ, dirtId);
                    chunk->setBlock(worldX, -61, worldZ, dirtId);
                    // grass сверху
                    chunk->setBlock(worldX, -60, worldZ, grassId);
                }
            }
        }
    }

    NC_INFO("World", "Flat мир сгенерирован: {}x{} чанков (радиус {})",
        radius * 2 + 1, radius * 2 + 1, radius);
}

