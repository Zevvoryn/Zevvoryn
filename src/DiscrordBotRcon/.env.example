# =============================================================================
#  Discord RCON Bot + Web Panel - configuration
#  Easiest way: run the setup wizard -> npm run setup (or: node setup.js)
#  It asks for the language first (English / Russian) and writes .env with
#  comments in that language. This file is the manual fallback: copy it to
#  ".env" and fill in the values. Never commit ".env".
# =============================================================================

# -----------------------------------------------------------------------------
#  DISCORD
# -----------------------------------------------------------------------------
# Bot token. Discord Developer Portal -> your application -> Bot -> Reset Token.
# This is the bot's password. Keep it secret.
DISCORD_TOKEN=

# Application (bot) ID, NOT your own user ID.
# Developer Portal -> your application -> General Information -> Application ID.
# Used only to register slash commands (deploy-commands.js).
CLIENT_ID=

# Your Discord server ID ("guild" = server in the Discord API).
# Discord -> Settings -> Advanced -> enable Developer Mode,
# then right-click the server icon -> Copy Server ID.
# Commands are registered for this server only (instant, no 1-hour wait).
GUILD_ID=

# -----------------------------------------------------------------------------
#  PERMISSIONS
# -----------------------------------------------------------------------------
# ID of the ROLE (not a user) allowed to run the bot's commands.
# Server Settings -> Roles -> right-click the role -> Copy Role ID.
# Empty = no role check (anyone in the allowed channel can run commands).
ADMIN_ROLE_ID=

# ID of the text channel where the bot accepts commands.
# Right-click the channel -> Copy Channel ID.
# Empty = commands work in any channel.
COMMAND_CHANNEL_ID=

# -----------------------------------------------------------------------------
#  RCON (connection to the Minecraft server)
# -----------------------------------------------------------------------------
# Server address. 127.0.0.1 if the bot runs on the same machine as the server.
RCON_HOST=127.0.0.1

# RCON port, taken from server.properties -> rcon.port (default 25575).
RCON_PORT=25575

# RCON password. Must match rcon.password in server.properties.
# server.properties must also have: enable-rcon=true
RCON_PASSWORD=

# How long to wait for an RCON reply, in milliseconds (10000 = 10 s).
RCON_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
#  WEB PANEL
#  The panel shows only: Connected / Players online / Whitelist / WS ping.
#  It always listens on 127.0.0.1 (local only). For remote access use an SSH
#  tunnel: ssh -L 3000:127.0.0.1:3000 user@host
# -----------------------------------------------------------------------------
# Start the web panel together with the bot. Any value except "false" = enabled.
WEB_ENABLED=true

# Panel port. Open http://127.0.0.1:3000
WEB_PORT=3000

# Login password for the web panel. Empty = no password (not recommended).
WEB_PASSWORD=change_me_123

# Optional second-level password for privileged (root) actions in the panel.
# Empty = privileged actions are disabled.
WEB_ROOT_PASSWORD=

# Session lifetime in minutes after a successful panel login (720 = 12 hours).
WEB_SESSION_TTL_MIN=720
